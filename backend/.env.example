# MongoDB connection (local or Atlas)
MONGO_URI=mongodb://localhost:27017/jobfilter

# Twilio — get these from https://console.twilio.com
# Leave the placeholders as they are to run in demo mode (messages print in the terminal).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp sandbox sender (this is the default sandbox number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your sandbox join phrase (Twilio console → Messaging → Try it out → WhatsApp)
# Shown in the app so new users know what to send. Example: join silver-tiger
TWILIO_SANDBOX_JOIN_CODE=join your-code-here

# Server port
PORT=5000
